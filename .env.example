# Copy this file to `.env` and replace the placeholders with your real values.
# Connection string for PostgreSQL (requires PostgreSQL >= 15).
DATABASE_URL="postgresql://user:password@localhost:5432/delivery"

# Secret used to sign JWTs. Required (and must be set explicitly) in production.
JWT_SECRET="change-me"

# Admin seed credentials (used by `npm run db:seed`).
ADMIN_EMAIL="admin@platform.test"
ADMIN_PASSWORD="Admin1234!"

# Server port and allowed CORS origin.
PORT=4000
CORS_ORIGIN=*

# Optional pricing overrides (USD).
# PRICE_BASE=2.5
# PRICE_PER_KM=1.25
# PRICE_PER_KG=0.4
# PRICE_MINIMUM=3

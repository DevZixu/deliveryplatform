{
  "name": "delivery-platform",
  "version": "1.0.0",
  "description": "REST API backend for a full-stack delivery platform (customers, riders, admins)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "contract:emit": "prisma contract emit",
    "db:plan": "prisma migration plan",
    "db:migrate": "prisma db migrate",
    "db:status": "prisma migration status",
    "db:verify": "prisma db verify",
    "db:seed": "tsx scripts/seed.ts",
    "test:smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@prisma/orm-postgres": "^8.0.0-rc.16",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.4",
    "prisma": "^8.0.0-rc.21",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=20"
  }
}

        "sql": "CREATE TABLE \"public\".\"deliveries\" (\n  \"assignedAt\" timestamptz,\n  \"cancelReason\" text,\n  \"cancellationActorId\" text,\n  \"cancelledAt\" timestamptz,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"currency\" text DEFAULT 'USD' NOT NULL,\n  \"customerId\" text NOT NULL,\n  \"deliveredAt\" timestamptz,\n  \"deliveryAddress\" text NOT NULL,\n  \"deliveryCity\" text NOT NULL,\n  \"deliveryNote\" text,\n  \"deliveryPhone\" text NOT NULL,\n  \"distanceKm\" numeric DEFAULT '1'::numeric NOT NULL,\n  \"fee\" numeric NOT NULL,\n  \"id\" text NOT NULL,\n  \"packageDescription\" text NOT NULL,\n  \"pickedUpAt\" timestamptz,\n  \"pickupAddress\" text NOT NULL,\n  \"pickupCity\" text NOT NULL,\n  \"pickupName\" text NOT NULL,\n  \"pickupNote\" text,\n  \"pickupPhone\" text NOT NULL,\n  \"recipientName\" text NOT NULL,\n  \"riderId\" text,\n  \"scheduledFor\" timestamptz,\n  \"status\" text DEFAULT 'PENDING' NOT NULL,\n  \"trackingCode\" text NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  \"weightKg\" numeric DEFAULT '1'::numeric NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"deliveries_status_check_6d1168c9\" CHECK (\"status\" IN ('PENDING', 'CONFIRMED', 'ASSIGNED', 'PICKED_UP', 'IN_TRANSIT', 'DELIVERED', 'CANCELLED')),\n  CONSTRAINT \"delivery_fee_non_negative_1b43b512\" CHECK (fee >= 0)\n)",
